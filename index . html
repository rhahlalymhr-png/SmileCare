                        </li>

                        <li>
                            Brush twice a day as recommended
                            by your dental professional.
                        </li>

                    </ul>


                    <button
                        class="speak-button"
                        onclick="speakLesson()">

                        🔊 Hear this lesson

                    </button>



                    <!-- CHARACTER SELECT -->

                    <div class="character-select">

                        <div class="character-select-label">
                            Choose your guide
                        </div>


                        <button
