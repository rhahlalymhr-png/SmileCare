                </div>



                <!-- CONTENT -->

                <div class="lesson-content">


                    <div
                        class="lesson-label"
                        id="lessonLabel">

                        Everyday Care

                    </div>


                    <h3
                        class="lesson-title"
                        id="lessonTitle">

                        Brush gently and thoroughly

                    </h3>


                    <p
                        class="lesson-text"
                        id="lessonText">

