        </div>



        <div class="learning-grid">


            <!-- =================================
                 TOOL BUTTONS
            ================================= -->

            <div class="tools">


                <button
                    class="tool-button active"
                    onclick="selectLesson('brush', this)">

                    <span class="tool-icon">
                        🪥
                    </span>

                    Toothbrush

                </button>


                <button
                    class="tool-button"
                    onclick="selectLesson('toothpaste', this)">

                    <span class="tool-icon">
                        🧴
                    </span>

                    Toothpaste

                </button>


                <button
                    class="tool-button"
                    onclick="selectLesson('floss', this)">

                    <span class="tool-icon">
                        🧵
                    </span>

                    Floss

                </button>


                <button
                    class="tool-button"
                    onclick="selectLesson('rinse', this)">

                    <span class="tool-icon">
                        💧
                    </span>

                    Rinse

                </button>


            </div>



            <!-- =================================
