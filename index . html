                        </button>


                        <button
                            class="character-button"
                            onclick="changeCharacter('man.webp', this)">

                            <img
                                src="man.webp"
                                alt="Man character">

                        </button>

                    </div>

                </div>

            </article>

        </div>

    </div>

</section>



<!-- =================================
     TIPS
================================= -->

<section id="tips">

    <div class="section-title">

        <span class="section-badge">
            Quick Knowledge
        </span>

        <h2>
            Small habits matter.
        </h2>

        <p>
            Simple reminders can help make oral care
            part of your everyday routine.
        </p>

    </div>


    <div class="tips-grid">


        <article class="tip-card">

            <div class="tip-icon">
                ⏱️
            </div>

            <h3>
                Take your time
            </h3>

            <p>

                Good brushing is about cleaning
                thoroughly and gently, rather than
                brushing harder.

            </p>

        </article>



        <article class="tip-card">

            <div class="tip-icon">
                🦷
            </div>

            <h3>
                Braces need extra care
            </h3>

            <p>

                Brackets and wires can create extra
