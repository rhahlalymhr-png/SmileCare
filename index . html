<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SmileCare | Oral Health Education</title>

<style>

:root {
    --pink: #f8dfe8;
    --pink-light: #fff7fa;
    --pink-dark: #e99bb7;
    --navy: #17263f;
    --navy-light: #263a5d;
    --white: #ffffff;
    --text: #17263f;
    --muted: #68758a;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--pink);
    color: var(--text);
}

button {
    font-family: inherit;
}

img {
    max-width: 100%;
}


/* =================================
   SIDE NAVIGATION
================================= */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 92px;
    background: var(--navy);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 22px 12px;
    z-index: 100;
}

.logo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: white;
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    font-weight: bold;
    margin-bottom: 35px;
}

.nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.nav-button {
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    background: white;
    color: var(--navy);
    font-size: 23px;
    cursor: pointer;
    transition: 0.25s;
}

.nav-button:hover {
    transform: scale(1.08);
    background: #ffdce8;
}


/* =================================
   MAIN
================================= */

main {
    margin-left: 92px;
}

section {
    padding: 85px 7%;
}


/* =================================
   HERO
================================= */

.hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 55px;
}

.hero-badge {
    display: inline-block;
    background: white;
    padding: 10px 17px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: bold;
}

.hero h1 {
    font-size: clamp(55px, 8vw, 95px);
    line-height: 0.92;
    letter-spacing: -5px;
    margin: 25px 0;
}

.hero h1 span {
    color: var(--pink-dark);
}

.hero-description {
    max-width: 610px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.75;
}

.start-button {
    margin-top: 20px;
    border: none;
    background: var(--navy);
    color: white;
    padding: 16px 25px;
    border-radius: 15px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.25s;
}

.start-button:hover {
    transform: translateY(-3px);
    background: var(--navy-light);
}

.hero-character {
    min-height: 580px;
    border-radius: 45px;
    background: rgba(255,255,255,0.55);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    position: relative;
}

.hero-character::after {
    content: "";
    position: absolute;
    bottom: 30px;
    width: 220px;
    height: 25px;
    background: rgba(23,38,63,0.13);
    border-radius: 50%;
    filter: blur(8px);
}

.hero-character img {
    width: 90%;
    height: 570px;
    object-fit: contain;
    position: relative;
    z-index: 2;
    animation: float 4s ease-in-out infinite;
}

@keyframes float {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }

}


/* =================================
   TITLES
================================= */

.section-badge {
    display: inline-block;
    background: white;
    padding: 9px 15px;
    border-radius: 25px;
    font-size: 12px;
    font-weight: bold;
}

.section-title h2 {
    font-size: clamp(38px, 5vw, 65px);
    margin: 15px 0;
}

.section-title p {
    color: var(--muted);
    line-height: 1.7;
    max-width: 720px;
}


/* =================================
   LEARNING AREA
================================= */

.learning-card {
    margin-top: 35px;
    background: rgba(255,255,255,0.58);
    padding: 25px;
    border-radius: 35px;
}

.mode-buttons {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
    flex-wrap: wrap;
}

.mode-button {
    border: none;
    background: white;
    padding: 13px 20px;
    border-radius: 30px;
    cursor: pointer;
    font-weight: bold;
}

.mode-button.active {
    background: var(--navy);
    color: white;
}

.learning-grid {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 25px;
}


/* =================================
   TOOL CIRCLES
================================= */

.tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.tool-button {
    aspect-ratio: 1;
    border: none;
    border-radius: 27px;
    background: white;
    cursor: pointer;
    font-weight: bold;
    color: var(--navy);
    box-shadow: 0 8px 20px rgba(23,38,63,0.07);
    transition: 0.25s;
}

.tool-button:hover {
    transform: translateY(-5px);
}

.tool-button.active {
    outline: 4px solid rgba(233,155,183,0.4);
    transform: translateY(-5px);
}

.tool-icon {
    display: block;
    font-size: 35px;
    margin-bottom: 9px;
}


/* =================================
   LESSON
================================= */

.lesson {
    min-height: 600px;
    background: var(--pink-light);
    border-radius: 30px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 45% 55%;
}

.character-stage {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(
        to bottom,
        #fffafb,
        #f5d5e1
    );
}

.character-stage::after {
    content: "";
    position: absolute;
    bottom: 30px;
    width: 230px;
    height: 27px;
    background: rgba(23,38,63,0.12);
    border-radius: 50%;
    filter: blur(8px);
}

.main-character {
    width: 100%;
    height: 590px;
    object-fit: contain;
    position: relative;
    z-index: 3;
}

.main-character.active-animation {
    animation: caring 1.4s ease-in-out infinite;
}

@keyframes caring {

    0%,100% {
        transform: translateY(0) rotate(0deg);
    }

    25% {
        transform: translateY(-5px) rotate(-1deg);
    }

    50% {
        transform: translateY(-9px) rotate(1deg);
    }

    75% {
        transform: translateY(-5px) rotate(-1deg);
    }

}


/* =================================
   ACTION BUBBLE
================================= */

.action-bubble {
    position: absolute;
    right: 20px;
    top: 25px;
    width: 78px;
    height: 78px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    z-index: 10;
    box-shadow: 0 10px 25px rgba(23,38,63,0.14);
    animation: actionBounce 1.2s infinite;
}

@keyframes actionBounce {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }

}


/* =================================
   ANIMATED CARE TOOL
================================= */

.care-tool {
    position: absolute;
    z-index: 8;
    font-size: 42px;
    opacity: 0;
    pointer-events: none;
}

.character-stage.brush .care-tool,
.character-stage.floss .care-tool,
.character-stage.rinse .care-tool,
.character-stage.toothpaste .care-tool {
    opacity: 1;
}

.character-stage.brush .care-tool {
    animation: brushAnimation 1.2s infinite;
}

@keyframes brushAnimation {

    0% {
        transform: translate(95px,-170px) rotate(-20deg);
    }

    50% {
        transform: translate(55px,-150px) rotate(20deg);
    }

    100% {
        transform: translate(95px,-170px) rotate(-20deg);
    }

}

.character-stage.floss .care-tool {
    animation: flossAnimation 1.4s infinite;
}

@keyframes flossAnimation {

    0%,100% {
        transform: translate(65px,-160px);
    }

    50% {
        transform: translate(40px,-145px);
    }

}

.character-stage.rinse .care-tool {
    animation: rinseAnimation 1.3s infinite;
}

@keyframes rinseAnimation {

    0%,100% {
        transform: translate(80px,-120px) rotate(-5deg);
    }

    50% {
        transform: translate(65px,-140px) rotate(5deg);
    }

}

.character-stage.toothpaste .care-tool {
    animation: toothpasteAnimation 1.3s infinite;
}

@keyframes toothpasteAnimation {

    0%,100% {
        transform: translate(90px,-180px) rotate(-10deg);
    }

    50% {
        transform: translate(65px,-160px) rotate(10deg);
    }

}


/* =================================
   LESSON CONTENT
================================= */

.lesson-content {
    padding: 45px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.lesson-label {
    color: var(--pink-dark);
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.lesson-title {
    font-size: 40px;
    margin: 12px 0;
}

.lesson-text {
    color: var(--muted);
    line-height: 1.75;
    font-size: 16px;
}

.steps {
    padding: 0;
    list-style: none;
}

.steps li {
    margin: 13px 0;
    line-height: 1.55;
}

.steps li::before {
    content: "✓";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 23px;
    height: 23px;
    border-radius: 50%;
    background: var(--navy);
    color: white;
    font-size: 12px;
    margin-right: 9px;
}

.speak-button {
    align-self: flex-start;
    border: none;
    background: white;
    color: var(--navy);
    padding: 13px 18px;
    border-radius: 13px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 8px;
}


/* =================================
   CHARACTER SELECT
================================= */

.character-select {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 25px;
}

.character-select-label {
    font-size: 13px;
    font-weight: bold;
    width: 100%;
    margin-bottom: 3px;
}

.character-button {
    width: 57px;
    height: 57px;
    border-radius: 50%;
    overflow: hidden;
    padding: 0;
    background: white;
    border: 3px solid transparent;
    cursor: pointer;
}

.character-button.active {
    border-color: var(--pink-dark);
}

.character-button img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}


/* =================================
   TIPS
================================= */

.tips-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
    margin-top: 35px;
}

.tip-card {
    background: white;
    border-radius: 25px;
    padding: 28px;
}

.tip-icon {
    font-size: 35px;
}

.tip-card h3 {
    margin-bottom: 8px;
}

.tip-card p {
    color: var(--muted);
    line-height: 1.65;
}


/* =================================
   FOOTER
================================= */

footer {
    padding: 30px 7% 70px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}


/* =================================
   MOBILE
================================= */

@media (max-width: 900px) {

    .sidebar {
        left: 0;
        right: 0;
        top: auto;
        bottom: 0;
        width: 100%;
        height: 74px;
        padding: 9px;
        flex-direction: row;
        justify-content: center;
        border-radius: 20px 20px 0 0;
    }

    .logo {
        display: none;
    }

    .nav {
        flex-direction: row;
    }

    main {
        margin-left: 0;
        padding-bottom: 65px;
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .hero-character {
        min-height: 430px;
    }

    .hero-character img {
        height: 420px;
    }

    .learning-grid {
        grid-template-columns: 1fr;
    }

    .lesson {
        grid-template-columns: 1fr;
    }

    .character-stage {
        min-height: 440px;
    }

    .main-character {
        height: 440px;
    }

    .tips-grid {
        grid-template-columns: 1fr;
    }
}


@media (max-width: 550px) {

    section {
        padding: 60px 18px;
    }

    .hero h1 {
        font-size: 57px;
        letter-spacing: -3px;
    }

    .hero-description {
        font-size: 16px;
    }

    .hero-character {
        min-height: 360px;
    }

    .hero-character img {
        height: 360px;
    }

    .learning-card {
        padding: 15px;
    }

    .lesson-content {
        padding: 25px;
    }

    .lesson-title {
        font-size: 31px;
    }

    .character-stage {
        min-height: 370px;
    }

    .main-character {
        height: 370px;
    }

    .tools {
        gap: 10px;
    }

}

</style>
</head>


<body>


<!-- =================================
     NAVIGATION
================================= -->

<aside class="sidebar">

    <div class="logo">
        S
    </div>

    <nav class="nav">

        <button class="nav-button" onclick="scrollToSection('home')">
            🏠
        </button>

        <button class="nav-button" onclick="scrollToSection('learn')">
            🦷
        </button>

        <button class="nav-button" onclick="scrollToSection('tips')">
            ✨
        </button>

        <button class="nav-button" onclick="speakLesson()">
            🔊
        </button>

    </nav>

</aside>


<main>


<!-- =================================
     HOME
================================= -->

<section class="hero" id="home">

    <div>

        <span class="hero-badge">
            🦷 SmileCare • Oral Health Education
        </span>

        <h1>
            Learn.<br>
            Brush.<br>
            <span>Smile.</span>
        </h1>

        <p class="hero-description">

            Welcome to SmileCare — a friendly interactive
