            title: "Protect your smile during treatment",

            text:
            "Keeping the areas around your brackets clean is an important part of orthodontic care.",

            steps: [

                "Follow your orthodontist's instructions.",

                "Do not rely on mouth rinse alone.",

                "Tell your orthodontic team if an appliance breaks."

            ]

        }

    }

};



/* =================================
   VARIABLES
================================= */

let currentMode = "everyday";

let currentLesson = "brush";



/* =================================
   SELECT LESSON
================================= */

function selectLesson(name, button) {

    currentLesson = name;

    document
        .querySelectorAll(".tool-button")
        .forEach(function(btn) {

            btn.classList.remove("active");

        });

    button.classList.add("active");

    updateLesson();

}



/* =================================
   CHANGE MODE
================================= */

function changeMode(mode, button) {

    currentMode = mode;

    document
        .querySelectorAll(".mode-button")
        .forEach(function(btn) {

            btn.classList.remove("active");

        });

    button.classList.add("active");

    updateLesson();

}



/* =================================
   UPDATE LESSON
================================= */

function updateLesson() {

    const lesson =
        lessons[currentMode][currentLesson];


    document
        .getElementById("lessonLabel")
        .textContent =
        currentMode === "everyday"
        ? "Everyday Care"
        : "Braces Care";


    document
        .getElementById("lessonTitle")
        .textContent =
        lesson.title;


    document
        .getElementById("lessonText")
        .textContent =
        lesson.text;


    document
        .getElementById("actionBubble")
        .textContent =
        lesson.icon;


    document
        .getElementById("careTool")
        .textContent =
        lesson.icon;


    const steps =
        document.getElementById("lessonSteps");


    steps.innerHTML = "";


    lesson.steps.forEach(function(step) {

        const li =
            document.createElement("li");

        li.textContent = step;

        steps.appendChild(li);

    });


    const stage =
        document.getElementById("characterStage");


    stage.classList.remove(
        "brush",
        "toothpaste",
        "floss",
        "rinse"
    );


    stage.classList.add(currentLesson);


    const character =
        document.getElementById("mainCharacter");


    character.classList.remove(
        "active-animation"
    );


    setTimeout(function() {

        character.classList.add(
            "active-animation"
        );

    }, 50);

}



/* =================================
   CHANGE CHARACTER
================================= */

function changeCharacter(file, button) {

    document
        .getElementById("mainCharacter")
        .src = file;


    document
        .querySelectorAll(".character-button")
        .forEach(function(btn) {

            btn.classList.remove("active");

        });


    button.classList.add("active");

}



/* =================================
   TEXT TO SPEECH
================================= */

function speakLesson() {

    if (!("speechSynthesis" in window)) {

        alert(
            "Text-to-speech is not supported by this browser."
        );

        return;

    }


    const lesson =
        lessons[currentMode][currentLesson];


    speechSynthesis.cancel();


    const text =
        lesson.title +
        ". " +
        lesson.text +
        " " +
        lesson.steps.join(" ");


    const speech =
        new SpeechSynthesisUtterance(text);


    speech.lang = "en-US";

    speech.rate = 0.9;

    speech.pitch = 1;


    speechSynthesis.speak(speech);

}



/* =================================
   SCROLL
================================= */

function scrollToSection(id) {

    document
        .getElementById(id)
        .scrollIntoView({
            behavior: "smooth"
        });

}



/* =================================
   START
================================= */

updateLesson();

</script>


