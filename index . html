<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SmileCare | Oral Health Education</title>

<style>
:root {
  --pink: #f8dfe8;
  --light-pink: #fff5f8;
  --navy: #18263f;
  --white: #ffffff;
  --text: #18263f;
  --muted: #68758a;
  --accent: #d97898;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--pink);
  color: var(--text);
}

button {
  font-family: inherit;
}

.app {
  min-height: 100vh;
}

/* =========================
   NAVIGATION
========================= */

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 90px;
  background: var(--navy);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22px 12px;
  z-index: 10;
}

.brand {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: white;
  display: grid;
  place-items: center;
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 30px;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.nav-btn {
  width: 55px;
  height: 55px;
  border: none;
  border-radius: 50%;
  background: white;
  color: var(--navy);
  font-size: 22px;
  cursor: pointer;
  transition: 0.2s;
}

.nav-btn:hover,
.nav-btn.active {
  background: #ffdce8;
  transform: translateY(-3px);
}

/* =========================
   MAIN
========================= */

main {
  margin-left: 90px;
}

section {
  padding: 80px 7%;
}

/* =========================
   HERO
========================= */

.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 50px;
}

.badge {
  display: inline-block;
  background: white;
  padding: 10px 15px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: bold;
}

.hero h1 {
  font-size: clamp(50px, 7vw, 90px);
  line-height: 0.95;
  margin: 25px 0;
  letter-spacing: -4px;
}

.hero p {
  color: var(--muted);
  font-size: 18px;
  line-height: 1.7;
  max-width: 600px;
}

.start-button {
  margin-top: 15px;
  border: none;
  background: var(--navy);
  color: white;
  padding: 15px 23px;
  border-radius: 14px;
  font-weight: bold;
  cursor: pointer;
  font-size: 15px;
}

.hero-card {
  min-height: 560px;
  background: rgba(255,255,255,0.55);
  border-radius: 40px;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  overflow: hidden;
}

.hero-card img {
  width: 90%;
  max-height: 550px;
  object-fit: contain;
  animation: floating 4s ease-in-out infinite;
}

@keyframes floating {
  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }
}

/* =========================
   TITLES
========================= */

.section-title {
  max-width: 700px;
  margin-bottom: 35px;
}

.section-title h2 {
  font-size: clamp(35px, 5vw, 60px);
  margin: 15px 0;
}

.section-title p {
  color: var(--muted);
  line-height: 1.7;
}

/* =========================
   LEARNING
========================= */

.learning-box {
  background: rgba(255,255,255,0.6);
  border-radius: 30px;
  padding: 25px;
}

.tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 25px;
  flex-wrap: wrap;
}

.tab {
  border: none;
  background: white;
  padding: 12px 18px;
  border-radius: 30px;
  font-weight: bold;
  cursor: pointer;
}

.tab.active {
  background: var(--navy);
  color: white;
}

.learning-grid {
  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 25px;
}

/* =========================
   CIRCLES
========================= */

.tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.tool {
  aspect-ratio: 1;
  border: none;
  background: white;
  border-radius: 25px;
  cursor: pointer;
  font-weight: bold;
  color: var(--navy);
  box-shadow: 0 8px 20px rgba(24,38,63,0.08);
  transition: 0.2s;
}

.tool:hover,
.tool.active {
  transform: translateY(-4px);
  outline: 3px solid rgba(217,120,152,0.25);
}

.tool-icon {
  display: block;
  font-size: 32px;
  margin-bottom: 8px;
}

/* =========================
   LESSON
========================= */

.lesson {
  background: var(--light-pink);
  border-radius: 28px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 45% 55%;
  min-height: 590px;
}

.character-area {
  position: relative;
  background: linear-gradient(
    to bottom,
    #fff9fb,
    #f6dce6
  );
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.character-area::after {
  content: "";
  position: absolute;
  bottom: 30px;
  width: 210px;
  height: 25px;
  background: rgba(24,38,63,0.12);
  border-radius: 50%;
  filter: blur(7px);
}

.character {
  width: 100%;
  height: 100%;
  max-height: 580px;
  object-fit: contain;
  position: relative;
  z-index: 2;
}

.character.moving {
  animation: characterMove 1.2s ease-in-out infinite;
}

@keyframes characterMove {
  0%,100% {
    transform: translateY(0) rotate(0);
  }

  50% {
    transform: translateY(-7px) rotate(1deg);
  }
}

.action {
  position: absolute;
  top: 25px;
  right: 20px;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: white;
  display: grid;
  place-items: center;
  font-size: 30px;
  z-index: 5;
  box-shadow: 0 10px 25px rgba(24,38,63,0.15);
}

.lesson-content {
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.lesson-label {
  color: var(--accent);
  text-transform: uppercase;
  font-weight: bold;
  font-size: 12px;
  letter-spacing: 2px;
}

.lesson-content h3 {
  font-size: 40px;
  margin: 12px 0;
}

.lesson-content p {
  color: var(--muted);
  line-height: 1.75;
}

.steps {
  padding: 0;
  list-style: none;
}

.steps li {
  margin: 12px 0;
  line-height: 1.5;
}

.steps li::before {
  content: "✓";
  background: var(--navy);
  color: white;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: inline-grid;
  place-items: center;
  margin-right: 9px;
  font-size: 12px;
}

.speak {
  align-self: flex-start;
  border: none;
  background: white;
  color: var(--navy);
  padding: 12px 17px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: bold;
}

/* =========================
   CHARACTERS
========================= */

.character-select {
  margin-top: 25px;
  display: flex;
  align-items: center;
  gap: 9px;
  flex-wrap: wrap;
}

.character-select strong {
  font-size: 13px;
}

.char-btn {
  width: 52px;
  height: 52px;
  border: 2px solid transparent;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: white;
  cursor: pointer;
}

.char-btn.active {
  border-color: var(--accent);
}

.char-btn img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* =========================
   TIPS
========================= */

.tips {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
}

.tip {
  background: white;
  padding: 25px;
  border-radius: 23px;
}

.tip-icon {
  font-size: 30px;
}

.tip h3 {
  margin-bottom: 8px;
}

.tip p {
  color: var(--muted);
  line-height: 1.6;
}

/* =========================
   FOOTER
========================= */

footer {
  padding: 35px 7% 60px;
  color: var(--muted);
  font-size: 13px;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

  .sidebar {
    top: auto;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 75px;
    flex-direction: row;
    justify-content: center;
    padding: 10px;
    border-radius: 20px 20px 0 0;
  }

  .brand {
    display: none;
  }

  .nav-list {
    flex-direction: row;
  }

  main {
    margin-left: 0;
    padding-bottom: 70px;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero-card {
    min-height: 400px;
  }

  .learning-grid {
    grid-template-columns: 1fr;
  }

  .lesson {
    grid-template-columns: 1fr;
  }

  .character-area {
    min-height: 420px;
  }

  .tips {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 550px) {

  section {
    padding: 60px 18px;
  }

  .hero h1 {
    font-size: 55px;
  }

  .hero-card {
    min-height: 360px;
  }

  .tools {
    grid-template-columns: 1fr 1fr;
  }

  .lesson-content {
    padding: 25px;
  }

  .lesson-content h3 {
    font-size: 30px;
  }

  .character-area {
    min-height: 350px;
  }
}
</style>
</head>

<body>

<div class="app">

<!-- NAVIGATION -->

<aside class="sidebar">

  <div class="brand">S</div>

  <nav class="nav-list">

    <button class="nav-btn active" onclick="goTo('home')">
      🏠
    </button>

    <button class="nav-btn" onclick="goTo('learn')">
      🪥
    </button>

    <button class="nav-btn" onclick="goTo('tips')">
      ✨
    </button>

    <button class="nav-btn" onclick="readLesson()">
      🔊
    </button>

  </nav>

</aside>


<main>

<!-- =========================
     HOME
========================= -->

<section class="hero" id="home">

  <div>

    <span class="badge">
      🦷 SmileCare • Oral Health Education
    </span>

    <h1>
      Learn.<br>
      Brush.<br>
      Smile.
    </h1>

    <p>
      An interactive and friendly guide to everyday oral hygiene
      and orthodontic care. Choose a topic, meet a character,
      and learn one simple step at a time.
    </p>

    <button class="start-button" onclick="goTo('learn')">
      Start learning →
    </button>

  </div>


  <div class="hero-card">

    <img
      src="assets/doctor-boy.webp"
      alt="Friendly dental care character"
    >

  </div>

</section>


<!-- =========================
     LEARN
========================= -->

<section id="learn">

  <div class="section-title">

    <span class="badge">
      Interactive lessons
    </span>

    <h2>
      Pick a tool. Watch. Learn.
    </h2>

    <p>
      Select a lesson below. The character will demonstrate
      a simple oral-care routine and you can hear the lesson
      in English.
    </p>

  </div>


  <div class="learning-box">

    <!-- MODE -->

    <div class="tabs">

      <button
        class="tab active"
        onclick="changeMode('everyday', this)">
        Everyday Care
      </button>

      <button
        class="tab"
        onclick="changeMode('braces', this)">
        Braces Care
      </button>

    </div>


    <div class="learning-grid">

      <!-- TOOLS -->

      <div class="tools">

        <button
          class="tool active"
          onclick="selectLesson('brush', this)">

          <span class="tool-icon">🪥</span>
          Toothbrush

        </button>


        <button
          class="tool"
          onclick="selectLesson('toothpaste', this)">

          <span class="tool-icon">🧴</span>
          Toothpaste

        </button>


        <button
          class="tool"
          onclick="selectLesson('floss', this)">

          <span class="tool-icon">🧵</span>
          Floss

        </button>


        <button
          class="tool"
          onclick="selectLesson('rinse', this)">

          <span class="tool-icon">💧</span>
          Rinse

        </button>

      </div>


      <!-- LESSON -->

      <article class="lesson">

        <div class="character-area">

          <div class="action" id="action">
            🪥
          </div>

          <img
            id="character"
            class="character moving"
            src="assets/girl.webp"
            alt="Character demonstrating oral hygiene"
          >

        </div>


        <div class="lesson-content">

          <div
            class="lesson-label"
            id="lessonLabel">
            Everyday Care
          </div>

          <h3 id="lessonTitle">
            Brush gently and thoroughly
          </h3>

          <p id="lessonText">
            Use a soft-bristled toothbrush and fluoride toothpaste.
            Brush all tooth surfaces gently and spend about two
            minutes cleaning your teeth.
          </p>


          <ul class="steps" id="steps">

            <li>
              Use gentle, small movements instead of scrubbing hard.
            </li>

            <li>
              Clean the outside, inside, and chewing surfaces
              of your teeth.
            </li>

            <li>
              Brush twice a day unless your dental professional
              advises otherwise.
            </li>

          </ul>


          <button class="speak" onclick="readLesson()">
            🔊 Hear this lesson
          </button>


          <div class="character-select">

            <strong>
              Choose your guide:
            </strong>


            <button
              class="char-btn active"
              onclick="changeCharacter('girl.webp', this)">

              <img
                src="assets/girl.webp"
                alt="Girl character">

            </button>


            <button
              class="char-btn"
              onclick="changeCharacter('doctor-boy.webp', this)">

              <img
                src="assets/doctor-boy.webp"
                alt="Doctor boy character">

            </button>


            <button
              class="char-btn"
              onclick="changeCharacter('woman.webp', this)">

              <img
                src="assets/woman.webp"
                alt="Woman character">

            </button>


            <button
              class="char-btn"
              onclick="changeCharacter('man.webp', this)">

              <img
                src="assets/man.webp"
                alt="Man character">

            </button>

          </div>

        </div>

      </article>

    </div>

  </div>

</section>


<!-- =========================
     TIPS
========================= -->

<section id="tips">

  <div class="section-title">

    <span class="badge">
      Quick Knowledge
    </span>

    <h2>
      Small habits matter.
    </h2>

    <p>
      Simple reminders for a healthier oral-care routine.
    </p>

  </div>


  <div class="tips">

    <article class="tip">

      <div class="tip-icon">
        ⏱️
      </div>

      <h3>
        Take your time
      </h3>

      <p>
        Good brushing is about covering all areas gently
        and thoroughly, not brushing harder.
      </p>

    </article>


    <article class="tip">

      <div class="tip-icon">
        🦷
      </div>

      <h3>
        Clean around braces
      </h3>

      <p>
        If you have braces, carefully clean around brackets
        and along the gumline.
      </p>

    </article>


    <article class="tip">

      <div class="tip-icon">
        👩‍⚕️
      </div>

      <h3>
        Ask a professional
      </h3>

      <p>
        This website provides general education.
        A dentist or orthodontist can give personal advice.
      </p>

    </article>

  </div>

</section>


<footer>

  <strong>SmileCare</strong> —
  An interactive oral-health education portfolio project.

  <br><br>

  Educational information does not replace advice
  from a dentist or orthodontist.

</footer>

</main>

</div>


<script>

/* =========================
   LESSON DATA
========================= */

const lessons = {

  everyday: {

    brush: {
      icon: "🪥",
      title: "Brush gently and thoroughly",
      text:
        "Use a soft-bristled toothbrush and fluoride toothpaste. Brush all tooth surfaces gently and spend about two minutes cleaning your teeth.",
      steps: [
        "Use gentle, small movements instead of scrubbing hard.",
        "Clean the outside, inside, and chewing surfaces of your teeth.",
        "Brush twice a day unless your dental professional advises otherwise."
      ]
    },

    toothpaste: {
      icon: "🧴",
      title: "Use fluoride toothpaste",
      text:
        "Fluoride toothpaste helps protect teeth from cavities. Use the amount recommended for your age and follow your dental professional's advice.",
      steps: [
        "Choose a fluoride toothpaste appropriate for you.",
        "Brush gently with a soft-bristled toothbrush.",
        "Follow the toothpaste instructions."
      ]
    },

    floss: {
      icon: "🧵",
      title: "Clean between your teeth",
      text:
        "Floss or use another interdental cleaner to remove plaque from places a toothbrush cannot easily reach.",
      steps: [
        "Guide the cleaner gently between your teeth.",
        "Curve it around each tooth.",
        "Do not force or snap it into your gums."
      ]
    },

    rinse: {
      icon: "💧",
      title: "Finish your routine",
      text:
        "A clean-mouth routine is more than brushing. Follow the oral-care routine recommended by your dental professional.",
      steps: [
        "Follow product instructions if you use mouth rinse.",
        "Do not use mouthwash as a replacement for brushing.",
        "Keep regular dental check-ups."
      ]
    }

  },


  braces: {

    brush: {
      icon: "🪥",
      title: "Brush around every bracket",
      text:
        "With braces, plaque can collect around brackets and wires. Use a soft toothbrush and clean carefully around every part of the appliance.",
      steps: [
        "Angle the brush to clean above and below brackets.",
        "Brush along the gumline gently.",
        "Follow your orthodontic team's brushing instructions."
      ]
    },

    toothpaste: {
      icon: "🧴",
      title: "Keep fluoride in your routine",
      text:
        "Fluoride toothpaste can help protect teeth while you wear braces. Your dentist or orthodontist can recommend the right routine.",
      steps: [
        "Use fluoride toothpaste as directed.",
        "Clean carefully around brackets and wires.",
        "Ask your orthodontic team if you are unsure."
      ]
    },

    floss: {
      icon: "🧵",
      title: "Clean under the wire",
      text:
        "Braces make cleaning between teeth more challenging. Orthodontic floss or interdental brushes may help.",
      steps: [
        "Use the cleaning method your orthodontic team taught you.",
        "Clean between teeth and around the gumline.",
        "Be gentle around brackets and wires."
      ]
    },

    rinse: {
      icon: "💧",
      title: "Protect your smile during treatment",
      text:
        "Keeping areas around brackets clean is especially important during orthodontic treatment.",
      steps: [
        "Follow your orthodontist's instructions.",
        "Do not rely on rinse alone.",
        "Report broken appliances to your orthodontic team."
      ]
    }

  }

};


let mode = "everyday";
let currentLesson = "brush";


/* =========================
   CHANGE LESSON
========================= */

function selectLesson(name, button) {

  currentLesson = name;

  document
    .querySelectorAll(".tool")
    .forEach(btn => btn.classList.remove("active"));

  button.classList.add("active");

  updateLesson();

}


/* =========================
   CHANGE MODE
========================= */

function changeMode(newMode, button) {

  mode = newMode;

  document
    .querySelectorAll(".tab")
    .forEach(tab => tab.classList.remove("active"));

  button.classList.add("active");

  updateLesson();

}


/* =========================
   UPDATE LESSON
========================= */

function updateLesson() {

  const lesson =
    lessons[mode][currentLesson];

  document.getElementById("action").textContent =
    lesson.icon;

  document.getElementById("lessonTitle").textContent =
    lesson.title;

  document.getElementById("lessonText").textContent =
    lesson.text;

  document.getElementById("lessonLabel").textContent =
    mode === "everyday"
      ? "Everyday Care"
      : "Braces Care";


  const list =
    document.getElementById("steps");

  list.innerHTML = "";

  lesson.steps.forEach(step => {

    const li = document.createElement("li");

    li.textContent = step;

    list.appendChild(li);

  });


  const character =
    document.getElementById("character");

  character.classList.remove("moving");

  setTimeout(() => {
    character.classList.add("moving");
  }, 20);

}


/* =========================
   CHANGE CHARACTER
========================= */

function changeCharacter(file, button) {

  document.getElementById("character").src =
    "assets/" + file;

  document
    .querySelectorAll(".char-btn")
    .forEach(btn =>
      btn.classList.remove("active")
    );

  button.classList.add("active");

}


/* =========================
   TEXT TO SPEECH
========================= */

function readLesson() {

  if (!("speechSynthesis" in window)) {
    alert("Speech is not supported by this browser.");
    return;
  }

  const lesson =
    lessons[mode][currentLesson];

  speechSynthesis.cancel();

  const text =
    lesson.title +
    ". " +
    lesson.text +
    " " +
    lesson.steps.join(" ");

  const speech =
    new SpeechSynthesisUtterance(text);

  speech.lang = "en-US";
  speech.rate = 0.9;

  speechSynthesis.speak(speech);

}


/* =========================
   SCROLL
========================= */

function goTo(id) {

  document
    .getElementById(id)
    .scrollIntoView({
      behavior: "smooth"
    });

}


/* START */

updateLesson();

</script>

</body>
</html>
